---
import Base from '../../layouts/Base.astro';
import Tiers from '../../components/Tiers.astro';
import Todo from '../../components/Todo.astro';
import Diagram from '../../components/Diagram.astro';
import Icon from '../../components/Icon.astro';
import StepArt, { type StepArtName } from '../../components/StepArt.astro';
import '../../styles/site.css';
import { langs, ui, url, asset, type Lang } from '../../i18n';
import { profile, sections as s, approach, legacy, timeline, downloads } from '../../data/profile';
import { cases } from '../../data/cases';
import { phrases, words } from '../../utils/phrases';
import { unitHtml } from '../../utils/numUnit';
import { imageSizes } from '../../data/imageSizes';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
// 代表作固定 Case 01、04，其他案例放在「更多作品」，用精簡卡片呈現
const FEATURED = ['booking', 'analytics'];
const featured = FEATURED.map((slug) => cases.find((c) => c.slug === slug)!);
const others = cases.filter((c) => !FEATURED.includes(c.slug));
const tx = <V,>(v: V | Record<Lang, V>): V =>
  v && typeof v === 'object' && lang in (v as object) ? (v as Record<Lang, V>)[lang] : (v as V);
const stepArt: Record<string, StepArtName> = { Discover: 'discover', Define: 'define', Design: 'design', Build: 'build', Validate: 'validate' };
---
<Base lang={lang} title={`${profile.nameEn} · Senior Product Designer`} description={profile.heroLead[lang]}>
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">{profile.heroEyebrow}</div>
        <h1>{profile.heroTitle[lang].map((line, i) => (
          <>{i > 0 && lang === 'zh-tw' && i === 2 && <br />}{lang === 'zh-tw' && i === 3 && ' '}{i > 0 && lang === 'en' && <br />}<span class="nw" set:html={line} /></>
        ))}</h1>
        <p class="lead">{profile.heroLead[lang]}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#work">{profile.ctaWork[lang]}</a>
          <a class="btn btn-ghost" href={url(lang, 'resume')}>{profile.ctaResume[lang]}</a>
        </div>
        <div class="stats">
          {profile.stats.map((st) => <div class="stat"><b set:html={unitHtml(st.value, lang)} /><span>{words(st.label[lang]).map((w) => w === ' ' ? ' ' : <span class="wd">{w}</span>)}</span></div>)}
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="shot shot-a"><img src={asset('img/real/official-home.webp')} alt="" width="1568" height="740"></div>
        <div class="shot shot-b"><img src={asset('img/real/liff-home.webp')} alt="" width="400" height="737"></div>
        <span class="tag">{profile.heroTag[lang]}</span>
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <div><div class="eyebrow">{s.work.eyebrow}</div><h2 id="work-title">{s.work.title[lang]}</h2></div>
        <p>{s.work.lead[lang]}</p>
      </div>
      <div class="cases">
        {featured.map((c) => (
          <a class="case" href={url(lang, `work/${c.slug}`)}>
            <div class="case-media">
              {c.card.kind === 'phones' && (
                <div class="phones">{c.card.src!.map((src) => <img src={asset(src)} alt="" width="400" height="737" loading="lazy" />)}</div>
              )}
              {c.card.kind === 'image' && <img src={asset(c.card.src![0])} alt="" loading="lazy" width={imageSizes[c.card.src![0]]?.[0]} height={imageSizes[c.card.src![0]]?.[1]} />}
              {c.card.kind === 'tiers' && <Tiers />}
              {c.card.kind === 'diagram' && <div class="card-diagram"><Diagram kind={c.card.diagram!} lang={lang} /></div>}
              <span class="label">{c.card.label[lang]}</span>
            </div>
            <div class="case-body">
              <span class="no">CASE {c.no} · {c.period}</span>
              <h3>{phrases(c.cardTitle[lang]).map((ph) => <span class="ph">{ph}</span>)}</h3>
              <p>{c.lead[lang]}</p>
              <div class="chips">{c.chips.map((ch, i) => <span class={i === 0 ? 'chip gold' : 'chip'}>{ch}</span>)}</div>
              <div class="kpis">{c.kpis.map(([v, l]) => <div><b set:html={unitHtml(v, lang)} /><span>{words(l[lang]).map((w) => w === ' ' ? ' ' : <span class="wd">{w}</span>)}</span></div>)}</div>
              <span class="more">{ui.case.read[lang]}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="more-head">
        <h3>{s.work.moreTitle[lang]}</h3>
        <p>{s.work.moreLead[lang]}</p>
      </div>
      <div class="cases-mini">
        {others.map((c) => (
          <a class="case-mini" href={url(lang, `work/${c.slug}`)}>
            <div class="mini-media">
              {c.card.kind === 'image' && <img src={asset(c.card.src![0])} alt="" loading="lazy" width={imageSizes[c.card.src![0]]?.[0]} height={imageSizes[c.card.src![0]]?.[1]} />}
              {c.card.kind === 'phones' && <div class="phones">{c.card.src!.map((src) => <img src={asset(src)} alt="" width="400" height="737" loading="lazy" />)}</div>}
              {c.card.kind === 'tiers' && <Tiers />}
              {c.card.kind === 'diagram' && <div class="mini-diagram"><Diagram kind={c.card.diagram!} lang={lang} /></div>}
            </div>
            <span class="no">CASE {c.no} · {c.period}</span>
            <h4>{phrases(c.cardTitle[lang]).map((ph) => <span class="ph">{ph}</span>)}</h4>
            <p>{c.lead[lang]}</p>
            <div class="chips">{c.chips.map((ch, i) => <span class={i === 0 ? 'chip gold' : 'chip'}>{ch}</span>)}</div>
            <span class="more">{ui.case.read[lang]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="chain" id="approach" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="section-head">
        <div><div class="eyebrow">{s.approach.eyebrow}</div><h2 id="approach-title">{s.approach.title[lang]}</h2></div>
        <p>{s.approach.lead[lang]}</p>
      </div>
      <div class="chain-grid">
        {approach.map((st) => <div class="step"><span class="step-icon"><StepArt name={stepArt[st.title]} /></span><span class="n">{st.n}</span><h3>{st.title}</h3><span class="role">{st.role}</span><p>{st.body[lang]}</p></div>)}
      </div>
      <div class="ai-bar"><span><b>AI-Integrated Workflow</b>　{s.approach.barLeft[lang]}</span><span>{s.approach.barRight[lang]}</span></div>
    </div>
  </section>

  <section id="experience" aria-labelledby="exp-title">
    <div class="wrap">
      <div class="section-head">
        <div><div class="eyebrow">{s.experience.eyebrow}</div><h2 id="exp-title">{s.experience.title[lang]}</h2></div>
        <p>{s.experience.lead[lang]}</p>
      </div>
      <ol class="timeline">
        {timeline.map((t) => (
          <li class={t.now ? 'now' : undefined}><span class="when">{tx(t.when)}</span><div><b>{tx(t.title)}</b><div class="co">{t.org[lang]}</div></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="legacy" id="legacy" aria-labelledby="legacy-title">
    <div class="wrap">
      <div class="section-head">
        <div><div class="eyebrow">{s.legacy.eyebrow}</div><h2 id="legacy-title">{s.legacy.title[lang].map((t) => <span class="nw">{t}</span>)}</h2></div>
        <p>{s.legacy.lead[lang]}</p>
      </div>
      <div class="legacy-grid">
        {legacy.map((l) => (
          <div class="legacy-card">
            <h3>{l.title[lang]}</h3><span class="when">{l.when[lang]}</span>
            <ul>{l.items[lang].map((it) => <li>{it}</li>)}{'works' in l && l.works.map((w) => <li><a href={w.url} target="_blank" rel="noopener" class="work-link">{w.title[lang]} ↗</a></li>)}</ul>
          </div>
        ))}
      </div>
      <p style="margin-top:28px"><a class="btn btn-ghost" href={profile.contact.behance} target="_blank" rel="noopener">{s.legacy.behance[lang]}</a></p>
    </div>
  </section>

  <section id="resume" aria-labelledby="resume-title">
    <div class="wrap">
      <div class="section-head">
        <div><div class="eyebrow">{s.download.eyebrow}</div><h2 id="resume-title">{s.download.title[lang]}</h2></div>
        <p>{s.download.lead[lang]}</p>
      </div>
      <div class="dl-grid">
        {(lang === 'en' ? [...downloads].sort((a, b) => Number(b.file.endsWith('_en.pdf')) - Number(a.file.endsWith('_en.pdf'))) : downloads).map((d) => (
          <div class="dl">
            <span class="ext">{d.ext[lang]}</span><b>{d.title[lang]}</b><span>{d.desc[lang]}</span>
            {d.file
              ? <a class={(lang === 'en' ? d.file.endsWith('_en.pdf') : d.primary) ? 'btn btn-primary btn-sm' : 'btn btn-ghost btn-sm'} href={asset(d.file)} download><Icon name="download" size={16} />PDF</a>
              : <span class={(lang === 'en' ? d.file.endsWith('_en.pdf') : d.primary) ? 'btn btn-primary btn-sm' : 'btn btn-ghost btn-sm'} aria-disabled="true">{s.download.pending[lang]}</span>}
          </div>
        ))}
      </div>
      <div class="contact">
        <div><h3>{s.download.contactTitle[lang]}</h3><p>{profile.contact.location[lang]}</p></div>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`mailto:${profile.contact.email}`}><Icon name="mail" size={18} />Email</a>
          <a class="btn btn-ghost" href={profile.contact.linkedin} target="_blank" rel="noopener">LinkedIn<Icon name="external" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

