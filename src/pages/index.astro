---
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/zh-tw/`;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex, nofollow">
  <meta http-equiv="refresh" content={`0; url=${target}`}>
  <title>Kenny Cheng</title>
  <link rel="canonical" href={target}>
</head>
<body><a href={target}>Kenny Cheng · Product Designer</a></body>
</html>
