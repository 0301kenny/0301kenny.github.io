---
// 依專案文件數據重繪的示意圖（中英雙語、行內 SVG）
import type { Lang } from '../i18n';
import type { DiagramKind } from '../data/cases';

interface Props { kind: DiagramKind; lang: Lang }
const { kind, lang } = Astro.props;
const zh = lang === 'zh-tw';
const t = (a: string, b: string) => (zh ? a : b);

const ruleItems = [
  t('官網與 LIFF 介面', 'Web & LIFF UI'), t('PRD', 'PRD'), t('後端 API', 'Backend API'),
  t('點數帳本', 'Points ledger'), t('QA 測試案例', 'QA test cases'), t('客服 FAQ', 'Support FAQ'),
];
const W = 290; // 100% 長條的寬度
const bars = [
  { title: t('點「選擇價格」後，走到訂單表單', 'Reached the booking form after "Select rate"'), rows: [[t('訪客', 'Visitors'), 9], [t('會員', 'Members'), 50]] },
  { title: t('走到表單之後的轉換', 'Conversion after reaching the form'), rows: [[t('訪客', 'Visitors'), 50], [t('會員', 'Members'), 46]] },
] as const;

// Case 05
const groups = [
  [t('活躍用戶', 'Active members'), t('為什麼留下', 'Why they stay')],
  [t('流失或觀望', 'Lapsed or undecided'), t('為什麼離開', 'Why they left')],
  [t('潛在用戶', 'Prospective members'), t('為什麼沒進來', 'Why they never joined')],
];
const steps = [
  { n: t('第 1 步', 'STEP 1'), lines: zh ? ['講師帶三人小組'] : ['Instructor leads', 'groups of three'], sub: '' },
  { n: t('第 2 步', 'STEP 2'), lines: zh ? ['練習得好的學員', '培養成引導者'] : ['Skilled members', 'trained as guides'], sub: '' },
  { n: t('第 3 步', 'STEP 3'), lines: zh ? ['引導者帶新成員'] : ['Guides lead', 'newcomers'], sub: t('講師在旁觀察', 'Instructor observes') },
];
const BW = 230; // 100% 長條寬度
const FX = zh ? 64 : 88; // Case 04 漏斗圖長條的起點：英文標籤比較長，要多留空間
const LH = 17; // 示意圖多行標籤的行距（14px 字約 1.2 倍）

// Case 06
const models = ['Whisper turbo', 'Breeze-ASR-25', 'TEA-ASR-1.1'];
const lanes = [
  { title: t('會議中：要快', 'During: speed first'), lines: [t('草稿約 3 秒出現', 'Draft in about 3 s'), t('AI 每 3 段糾正一次', 'AI fixes every 3 segments'), t('糾正後原地覆蓋草稿', 'Fixed text replaces draft')], dark: true },
  { title: t('會議後：要準', 'After: accuracy first'), lines: [t('三個模型整場重轉', 'Full re-transcription'), t('對照公司字典逐批精修', 'Refine with the glossary'), t('擷取決策，附上原句', 'Extract decisions + quotes')], dark: false },
];
const planSteps = [
  t('介面盤點', 'UI audit'),
  t('收斂成辦公室工具', 'Refocus as an office tool'),
  t('加入長期功能', 'Add long-term features'),
  t('核心需求提前到第 2 階段', 'Core need moved to phase 2'),
  t('錄音保護提前', 'Recording safety moved up'),
];
const LW = 300; // 17 秒的長條寬度

// Case 01 資訊架構、Case 04 載入迴圈
const iaCols = [
  { title: t('導覽入口', 'Navigation'), items: zh ? ['酒店', '會員', '私人訂製', '通關', '極致奢旅', '文章'] : ['Hotels', 'Membership', 'Bespoke', 'Airport', 'Ultra Luxe', 'Articles'] },
  { title: t('訂房主線', 'Booking path'), items: zh ? ['目的地搜尋', '結果篩選', '地圖', '房型與方案', '結帳'] : ['Search', 'Filters', 'Map', 'Rooms & rates', 'Checkout'] },
  { title: t('會員中心', 'Member center'), items: zh ? ['會籍總覽', '酒店訂單', '一般訂單', '個人資料', '我的收藏'] : ['Membership', 'Hotel bookings', 'Other orders', 'Profile', 'Saved'] },
  { title: t('標準頁', 'Browse pages'), items: zh ? ['集團', '品牌', '國家', '城市'] : ['Groups', 'Brands', 'Countries', 'Cities'] },
];
const loopSteps = [t('打開酒店頁', 'Open hotel'), t('載入逾時', 'Load times out'), t('顯示查無酒店', "'No hotel'"), t('按上一頁', 'Tap back')];
const latency = [
  { title: t('95% 段落的草稿延遲', 'Draft delay at the 95th percentile'), rows: [[t('修正前', 'Before'), 6.7], [t('修正後', 'After'), 3.2]] },
  { title: t('最慢的一段', 'Slowest segment'), rows: [[t('修正前', 'Before'), 17], [t('修正後', 'After'), 5.9]] },
] as const;
const pct = [
  { label: zh ? ['聽過但沒實踐'] : ['Heard of it,', 'not practicing'], v: 70, n: '14/20', fill: 'var(--d-gold)' },
  { label: [t('全體填答', 'All respondents')], v: 56, n: '24/43', fill: 'var(--d-ink-3)' },
  { label: [t('有在實踐', 'Practicing')], v: 25, n: '3/12', fill: 'var(--d-ink)' },
];
---
<div class="diagram">
  {kind === 'channels' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('官網、LINE LIFF、銀行白牌三個前台共用一套後端與後台，並共用 11 個元件庫（735 個元件與變體）與四語系 3,548 個字串', 'Website, LINE LIFF, and bank white-label sites share one backend and admin system, plus 11 component libraries (735 components and variants) and 3,548 strings in four languages')}>
      {[t('官網', 'Website'), 'LINE LIFF', t('銀行白牌', 'Bank sites')].map((label, i) => (
        <g>
          <rect x={10 + i * 160} y="10" width="140" height="56" rx="10" fill="var(--d-bg)" stroke="var(--d-line)" />
          <text x={80 + i * 160} y="44" text-anchor="middle" font-size="16" font-weight="600" fill="var(--d-ink)">{label}</text>
          <line x1={80 + i * 160} y1="66" x2={80 + i * 160} y2="106" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-c)" />
        </g>
      ))}
      <defs><marker id="arr-c" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker></defs>
      <rect x="10" y="110" width="460" height="56" rx="10" fill="var(--d-ink)" />
      <text x="240" y="144" text-anchor="middle" font-size="16" font-weight="600" fill="#fff">{t('共用一套後端與後台', 'One shared backend and admin')}</text>
      <rect x="10" y="186" width="460" height="104" rx="10" fill="var(--d-gold-soft)" />
      <text x="240" y="212" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-gold)">{t('三個前台共用的設計基礎', 'Design foundation shared by all three')}</text>
      {[['11', t('個共用元件庫', 'component libraries')], ['735', t('個元件與變體', 'components & variants')], ['3,548', t('個字串 × 4 語系', 'strings, 4 languages')]].map(([v, l], i) => (
        <g>
          <text x={88 + i * 152} y="252" text-anchor="middle" font-size="24" fill="var(--d-ink)">{v}</text>
          <text x={88 + i * 152} y="276" text-anchor="middle" font-size={zh ? 15 : 13} fill="var(--d-ink-2)">{l}</text>
        </g>
      ))}
    </svg>
  )}

  {kind === 'rules' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('一條規則（住三付二的贈送房晚也要計入）要同時改 6 個地方：官網與 LIFF 介面、PRD、後端 API、點數帳本、QA 測試案例、客服 FAQ', 'One rule (complimentary nights count too) must change in six places at once: web and LIFF UI, PRD, backend API, points ledger, QA test cases, support FAQ')}>
      <rect x="70" y="10" width="340" height="66" rx="10" fill="var(--d-ink)" />
      <text x="240" y="38" text-anchor="middle" font-size="16" font-weight="600" fill="#fff">{t('一條規則', 'One rule')}</text>
      <text x="240" y="61" text-anchor="middle" font-size="14" fill="#C5D1E0">{t('例：「住三付二」贈送的房晚也要計入', 'e.g. free nights in "stay 3, pay 2" count too')}</text>
      <defs><marker id="arr-r" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker></defs>
      <line x1="240" y1="76" x2="240" y2="104" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-r)" />
      <rect x="10" y="108" width="460" height="182" rx="10" fill="var(--d-surface)" />
      <text x="240" y="134" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-gold)">{t('必須同時修改的 6 個地方', 'Six places that must change together')}</text>
      {ruleItems.map((label, i) => (
        <g>
          <rect x={22 + (i % 3) * 148} y={150 + Math.floor(i / 3) * 66} width="140" height="52" rx="8" fill="var(--d-bg)" stroke="var(--d-line)" />
          <text x={92 + (i % 3) * 148} y={181 + Math.floor(i / 3) * 66} text-anchor="middle" font-size="16" fill="var(--d-ink)">{label}</text>
        </g>
      ))}
    </svg>
  )}

  {kind === 'funnel' && (
    <svg viewBox="0 0 420 300" role="img" aria-label={t('點選擇價格後，訪客 9%、會員 50% 走到訂單表單；走到表單後，訪客轉換 50%、會員 46%。落差出在登入這一步', 'After "Select rate," 9% of guests and 50% of members reached the form; once there, guests converted at 50% and members at 46%. The gap is the login step')}>
      {bars.map((g, gi) => (
        <g>
          <text x="10" y={22 + gi * 118} font-size="16" font-weight="600" fill="var(--d-ink)">{g.title}</text>
          {g.rows.map(([label, v], ri) => (
            <g>
              <text x="10" y={59 + gi * 118 + ri * 36} font-size="15" fill="var(--d-ink-2)">{label}</text>
              <rect x={FX} y={42 + gi * 118 + ri * 36} width={W} height="24" rx="5" fill="var(--d-surface)" />
              <rect x={FX} y={42 + gi * 118 + ri * 36} width={(W * v) / 100} height="24" rx="5" fill={ri === 0 ? 'var(--d-gold)' : 'var(--d-ink)'} />
              <text x={FX + 8 + (W * v) / 100} y={60 + gi * 118 + ri * 36} font-size="16" font-weight="600" fill="var(--d-ink)">{v}%</text>
            </g>
          ))}
        </g>
      ))}
      <rect x="10" y="244" width="400" height="48" rx="10" fill="var(--d-gold-soft)" />
      <text x="210" y="274" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-ink)">{t('落差出在登入這一步；登入後只有 44% 回到表單', 'Drop-off happens at login; only 44% return')}</text>
    </svg>
  )}
  {kind === 'groups' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('三組研究員各研究一群用戶：活躍用戶（為什麼留下）、流失或觀望用戶（為什麼離開）、潛在用戶（為什麼沒進來），各 6 位受訪者，最後三組整合並向業主簡報', 'Three research teams each studied one group: active members (why they stay), lapsed members (why they left), prospective members (why they never joined), six interviews each, then merged findings into a client readout')}>
      <defs><marker id="arr-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker></defs>
      {groups.map(([title, q], i) => (
        <g>
          <rect x={10 + i * 156} y="10" width="148" height="104" rx="10" fill="var(--d-bg)" stroke="var(--d-line)" />
          <text x={84 + i * 156} y="42" text-anchor="middle" font-size={zh ? 16 : 13.5} font-weight="600" fill="var(--d-ink)">{title}</text>
          <text x={84 + i * 156} y="68" text-anchor="middle" font-size={zh ? 14 : 13} fill="var(--d-gold)">{q}</text>
          <text x={84 + i * 156} y="94" text-anchor="middle" font-size="13" fill="var(--d-ink-3)">{t('6 位受訪者', '6 interviews')}</text>
          <line x1={84 + i * 156} y1="114" x2={84 + i * 156} y2="146" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-g)" />
        </g>
      ))}
      <rect x="10" y="150" width="460" height="52" rx="10" fill="var(--d-ink)" />
      <text x="240" y="182" text-anchor="middle" font-size="16" font-weight="600" fill="#fff">{t('三組整合：親合圖、同理心地圖', 'Cross-team synthesis: affinity and empathy mapping')}</text>
      <line x1="240" y1="202" x2="240" y2="230" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-g)" />
      <rect x="10" y="234" width="460" height="56" rx="10" fill="var(--d-gold-soft)" />
      <text x="240" y="268" text-anchor="middle" font-size="16" font-weight="600" fill="var(--d-ink)">{t('2022 年 12 月向業主簡報', 'Client readout, December 2022')}</text>
    </svg>
  )}

  {kind === 'triad' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('三人小組：引導者和被引導者互相提問與回答，旁觀者觀察兩人；社群搬到 Discord 後，固定成員改成隨機配對', 'Three-person group: the guide and speaker ask each other questions, the observer watches both; after moving to Discord, fixed members became random pairs')}>
      <defs>
        <marker id="arr-t" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker>
      </defs>
      <line x1="114" y1="96" x2="206" y2="96" stroke="var(--d-ink-3)" stroke-width="1.5" marker-start="url(#arr-t)" marker-end="url(#arr-t)" />
      <text x="160" y="84" text-anchor="middle" font-size="14" fill="var(--d-ink-2)">{t('提問／回答', 'ask / answer')}</text>
      <line x1="138" y1="198" x2="96" y2="138" stroke="var(--d-ink-3)" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arr-t)" />
      <line x1="182" y1="198" x2="224" y2="138" stroke="var(--d-ink-3)" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arr-t)" />
      <text x="160" y="160" text-anchor="middle" font-size="14" fill="var(--d-ink-2)">{t('觀察', 'observes both')}</text>
      <circle cx="70" cy="96" r="42" fill="var(--d-ink)" />
      <text x="70" y="102" text-anchor="middle" font-size="16" font-weight="600" fill="#fff">{t('引導者', 'Guide')}</text>
      <circle cx="250" cy="96" r="42" fill="var(--d-gold)" />
      <text x="250" y="102" text-anchor="middle" font-size="16" font-weight="600" fill="#fff">{t('被引導者', 'Speaker')}</text>
      <circle cx="160" cy="238" r="42" fill="var(--d-bg)" stroke="var(--d-ink-3)" />
      <text x="160" y="244" text-anchor="middle" font-size="16" font-weight="600" fill="var(--d-ink)">{t('旁觀者', 'Observer')}</text>
      <text x="160" y="296" text-anchor="middle" font-size="13" fill="var(--d-ink-3)">{t('三人輪流擔任三種角色', 'Members rotate through all three roles')}</text>
      <rect x="326" y="10" width="144" height="280" rx="10" fill="var(--d-surface)" />
      <text x="398" y="40" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-ink)">{t('配對方式', 'How groups form')}</text>
      <rect x="340" y="58" width="116" height="70" rx="8" fill="var(--d-bg)" stroke="var(--d-line)" />
      <text x="398" y="88" text-anchor="middle" font-size="16" font-weight="600" fill="var(--d-ink)">LINE</text>
      <text x="398" y="112" text-anchor="middle" font-size="14" fill="var(--d-ink-2)">{t('固定成員', 'Fixed members')}</text>
      <line x1="398" y1="128" x2="398" y2="162" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-t)" />
      <rect x="340" y="166" width="116" height="70" rx="8" fill="var(--d-bg)" stroke="var(--d-line)" />
      <text x="398" y="196" text-anchor="middle" font-size="16" font-weight="600" fill="var(--d-ink)">Discord</text>
      <text x="398" y="220" text-anchor="middle" font-size="14" fill="var(--d-ink-2)">{t('隨機配對', 'Random matching')}</text>
      <text x="398" y="268" text-anchor="middle" font-size="14" font-weight="600" fill="var(--d-gold)">{t('熟悉感變弱', 'Less familiarity')}</text>
    </svg>
  )}

  {kind === 'mentor' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('學長姊機制三步：講師帶三人小組；練習得好的學員培養成引導者；引導者帶新成員，講師在旁觀察', 'Mentor model in three steps: the instructor leads groups of three; strong members are trained as guides; guides lead newcomers while the instructor observes')}>
      {steps.map((st, i) => {
        const cx = 84 + i * 156;
        const top = i === 2 ? 'var(--d-gold)' : 'var(--d-ink)';
        return (
          <g>
            <rect x={10 + i * 156} y="10" width="148" height="250" rx="10" fill="var(--d-surface)" />
            <text x={cx} y="38" text-anchor="middle" font-size="13" font-weight="600" fill="var(--d-gold)">{st.n}</text>
            {[-40, 0, 40].map((dx) => <line x1={cx} y1="78" x2={cx + dx} y2="138" stroke="var(--d-ink-3)" stroke-width="1.5" />)}
            <circle cx={cx} cy="78" r="16" fill={top} />
            {[-40, 0, 40].map((dx) => <circle cx={cx + dx} cy="144" r="13" fill={i === 1 && dx === 0 ? 'var(--d-gold)' : 'var(--d-bg)'} stroke={i === 1 && dx === 0 ? 'none' : 'var(--d-ink-3)'} />)}
            {i === 2 && <circle cx={cx + 48} cy="62" r="11" fill="none" stroke="var(--d-ink)" stroke-dasharray="3 3" />}
            {st.lines.map((ln, li) => <text x={cx} y={194 + li * 22} text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-ink)">{ln}</text>)}
            {st.sub && <text x={cx} y="244" text-anchor="middle" font-size="13" fill="var(--d-ink-2)">{st.sub}</text>}
          </g>
        );
      })}
      {[[t('講師', 'Instructor'), 'var(--d-ink)', 'none'], [t('引導者', 'Guide'), 'var(--d-gold)', 'none'], [t('學員', 'Member'), 'var(--d-bg)', 'var(--d-ink-3)']].map(([label, fill, stroke], i) => (
        <g>
          <circle cx={128 + i * 100} cy="282" r="7" fill={fill} stroke={stroke} />
          <text x={140 + i * 100} y="287" font-size="13" fill="var(--d-ink-2)">{label}</text>
        </g>
      ))}
    </svg>
  )}

  {kind === 'bars' && (
    <svg viewBox="0 0 480 236" role="img" aria-label={t('2026 年回頭重看問卷：認為做重要決定時邏輯比心情重要的比例，聽過但沒實踐 70%（14/20）、全體填答 56%（24/43）、有在實踐 25%（3/12）', 'Survey revisited in 2026: share who say logic matters more than feelings in big decisions. Heard of it but not practicing 70% (14/20), all respondents 56% (24/43), practicing 25% (3/12)')}>
      <text x="10" y="24" font-size="16" font-weight="600" fill="var(--d-ink)">{t('做重要決定時，邏輯比心情重要', 'Logic matters more than feelings in big decisions')}</text>
      <text x="10" y="46" font-size="13" fill="var(--d-ink-2)">{t('回答「同意」或「非常同意」的比例', 'Share answering "agree" or "strongly agree"')}</text>
      {pct.map((r, i) => (
        <g>
          <text font-size="14" fill="var(--d-ink-2)">{r.label.map((line, j) => <tspan x="10" y={89 + i * 44 + (j - (r.label.length - 1) / 2) * LH}>{line}</tspan>)}</text>
          <rect x="160" y={72 + i * 44} width={BW} height="24" rx="5" fill="var(--d-surface)" />
          <rect x="160" y={72 + i * 44} width={(BW * r.v) / 100} height="24" rx="5" fill={r.fill} />
          <text x={168 + (BW * r.v) / 100} y={90 + i * 44} font-size="15" font-weight="600" fill="var(--d-ink)">{r.v}%<tspan font-size="13" font-weight="400" fill="var(--d-ink-3)"> ({r.n})</tspan></text>
        </g>
      ))}
      <text x="10" y="226" font-size="13" fill="var(--d-ink-3)">{t('2026 回頭重看 · 單題自評 · 樣本小', 'Revisited in 2026 · one self-rated question · small samples')}</text>
    </svg>
  )}
  {kind === 'memflow' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('會議聲音由三個本機模型同時辨識，分成兩層：會議中求快，草稿約 3 秒出現，AI 每 3 段糾正一次並原地覆蓋；會議後求準，三個模型整場重轉、對照公司字典精修，並擷取附原句的決策', 'Meeting audio is transcribed by three on-device models in two stages: during the meeting, a draft appears in about 3 seconds and AI fixes every 3 segments in place; afterward, the full meeting is re-transcribed, refined with the glossary, and decisions are extracted with quotes')}>
      <defs><marker id="arr-m" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker></defs>
      <rect x="10" y="10" width="460" height="40" rx="10" fill="var(--d-surface)" />
      <text x="240" y="36" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-ink)">{t('會議聲音（麥克風＋電腦聲音）', 'Meeting audio (mic + system audio)')}</text>
      {models.map((m, i) => (
        <g>
          <line x1={84 + i * 156} y1="50" x2={84 + i * 156} y2="68" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-m)" />
          <rect x={10 + i * 156} y="72" width="148" height="42" rx="8" fill="var(--d-bg)" stroke="var(--d-line)" />
          <text x={84 + i * 156} y="98" text-anchor="middle" font-size="14" font-weight="600" fill="var(--d-ink)">{m}</text>
        </g>
      ))}
      {models.map((_, i) => <line x1={84 + i * 156} y1="114" x2={84 + i * 156} y2="134" stroke="var(--d-ink-3)" stroke-width="1.5" />)}
      <line x1="84" y1="134" x2="396" y2="134" stroke="var(--d-ink-3)" stroke-width="1.5" />
      {lanes.map((ln, i) => (
        <g>
          <line x1={122 + i * 236} y1="134" x2={122 + i * 236} y2="160" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-m)" />
          <rect x={10 + i * 236} y="164" width="224" height="126" rx="10" fill={ln.dark ? 'var(--d-ink)' : 'var(--d-gold-soft)'} />
          <text x={122 + i * 236} y="192" text-anchor="middle" font-size="16" font-weight="600" fill={ln.dark ? '#fff' : 'var(--d-ink)'}>{ln.title}</text>
          {ln.lines.map((l, li) => <text x={122 + i * 236} y={220 + li * 24} text-anchor="middle" font-size="14" fill={ln.dark ? '#C5D1E0' : 'var(--d-ink-2)'}>{l}</text>)}
        </g>
      ))}
    </svg>
  )}

  {kind === 'correction' && (
    <svg viewBox="0 0 480 300" role="img" aria-label={t('糾錯流程：三個模型的版本先經規則快修，已知誤聽直接替換；AI 只能從三個版本和公司字典裡挑；有把握的寫入逐字稿，不確定的列為待確認詞', 'Correction flow: three model versions first get rule-based fixes for known mishearings; AI may only choose from the versions and the glossary; confident fixes go into the transcript, unsure ones are flagged for review')}>
      <defs><marker id="arr-x" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker></defs>
      <rect x="10" y="10" width="460" height="46" rx="10" fill="var(--d-bg)" stroke="var(--d-line)" />
      <text x="240" y="39" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-ink)">{t('三個模型各自的辨識結果', 'Three model transcripts')}</text>
      <line x1="240" y1="56" x2="240" y2="76" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-x)" />
      <rect x="10" y="80" width="460" height="56" rx="10" fill="var(--d-surface)" />
      <text x="240" y="104" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-ink)">{t('規則快修', 'Rule-based fixes')}</text>
      <text x="240" y="125" text-anchor="middle" font-size="13" fill="var(--d-ink-2)">{t('字典裡已知的誤聽直接替換，不呼叫 AI', 'Known mishearings fixed from the glossary, no AI call')}</text>
      <line x1="240" y1="136" x2="240" y2="156" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-x)" />
      <rect x="10" y="160" width="460" height="56" rx="10" fill="var(--d-ink)" />
      <text x="240" y="184" text-anchor="middle" font-size="15" font-weight="600" fill="#fff">{t('AI 只能挑，不能改寫', 'AI may choose, not rewrite')}</text>
      <text x="240" y="205" text-anchor="middle" font-size="13" fill="#C5D1E0">{t('只從三個版本和公司字典裡選出組合', 'Picks only from the three versions and the glossary')}</text>
      <line x1="122" y1="216" x2="122" y2="234" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-x)" />
      <line x1="358" y1="216" x2="358" y2="234" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-x)" />
      <rect x="10" y="238" width="224" height="52" rx="10" fill="var(--d-bg)" stroke="var(--d-line)" />
      <text x="122" y="269" text-anchor="middle" font-size="15" fill="var(--d-ink)">{t('有把握：寫入逐字稿', 'Confident: added to transcript')}</text>
      <rect x="246" y="238" width="224" height="52" rx="10" fill="var(--d-gold-soft)" />
      <text x="358" y="269" text-anchor="middle" font-size="15" font-weight="600" fill="var(--d-gold)">{t('不確定：列為待確認詞', 'Uncertain: flagged for review')}</text>
    </svg>
  )}

  {kind === 'plan' && (
    <svg viewBox="0 0 360 290" style="max-width:380px;margin:0 auto" role="img" aria-label={t('計劃從 v1 改到 v5：介面盤點、收斂成辦公室工具、加入長期功能；我要求 AI 自省後，核心需求提前到第 2 階段；再請 Codex 當挑戰者審閱後，錄音保護提前', 'The plan evolved from v1 to v5: interface audit, refocus for office users, add long-term features; after I asked for a self-review, the core need moved to phase 2; after Codex reviewed it as a challenger, recording safety moved up')}>
      <line x1="44" y1="32" x2="44" y2="264" stroke="var(--d-line)" stroke-width="2" />
      {planSteps.map((label, i) => (
        <g>
          <circle cx="44" cy={32 + i * 58} r="18" fill={i >= 3 ? 'var(--d-gold)' : 'var(--d-bg)'} stroke={i >= 3 ? 'none' : 'var(--d-ink-3)'} />
          <text x="44" y={37 + i * 58} text-anchor="middle" font-size="13" font-weight="600" fill={i >= 3 ? '#fff' : 'var(--d-ink)'}>v{i + 1}</text>
          <text x="78" y={37 + i * 58} font-size="15" font-weight={i >= 3 ? '600' : '400'} fill="var(--d-ink)">{label}</text>
        </g>
      ))}
      {[[t('我要求 AI 自省', 'I had AI critique itself'), 177], [t('請 Codex 當挑戰者審閱', 'Codex reviewed as a challenger'), 235]].map(([label, y]) => (
        <text x="78" y={Number(y) + 5} font-size="13" fill="var(--d-gold)">↓ {label}</text>
      ))}
    </svg>
  )}

  {kind === 'latency' && (
    <svg viewBox="0 0 480 268" role="img" aria-label={t('同一場 9 分鐘會議重播量測：95% 段落的草稿延遲從 6.7 秒降到 3.2 秒；最慢的一段從 17 秒降到 5.9 秒', 'Replay of the same 9-minute meeting: 95th-percentile draft delay fell from 6.7 to 3.2 seconds; the slowest segment fell from 17 to 5.9 seconds')}>
      {latency.map((g, gi) => (
        <g>
          <text x="10" y={22 + gi * 116} font-size="16" font-weight="600" fill="var(--d-ink)">{g.title}</text>
          {g.rows.map(([label, v], ri) => (
            <g>
              <text x="10" y={59 + gi * 116 + ri * 36} font-size="15" fill="var(--d-ink-2)">{label}</text>
              <rect x="80" y={42 + gi * 116 + ri * 36} width={LW} height="24" rx="5" fill="var(--d-surface)" />
              <rect x="80" y={42 + gi * 116 + ri * 36} width={(LW * v) / 17} height="24" rx="5" fill={ri === 0 ? 'var(--d-ink-3)' : 'var(--d-gold)'} />
              <text x={88 + (LW * v) / 17} y={60 + gi * 116 + ri * 36} font-size="15" font-weight="600" fill="var(--d-ink)">{v}{t(' 秒', ' s')}</text>
            </g>
          ))}
        </g>
      ))}
      <text x="10" y="258" font-size="13" fill="var(--d-ink-3)">{t('同一場 9 分鐘會議重播量測 · 目標 3 秒內', 'Replay of the same 9-minute meeting · target: within 3 s')}</text>
    </svg>
  )}
  {kind === 'ia' && (
    <svg viewBox="0 0 480 288" role="img" aria-label={t('官網 3.0 資訊架構：導覽入口、訂房主線、會員中心、標準頁四大區塊', 'Website v3.0 information architecture: navigation, booking path, member center, and landing pages')}>
      <rect x="10" y="10" width="460" height="38" rx="10" fill="var(--d-ink)" />
      <text x="240" y="35" text-anchor="middle" font-size="16" font-weight="600" fill="#fff">{t('官網 3.0', 'Website v3.0')}</text>
      <line x1="65" y1="58" x2="415" y2="58" stroke="var(--d-ink-3)" stroke-width="1.5" />
      <line x1="240" y1="48" x2="240" y2="58" stroke="var(--d-ink-3)" stroke-width="1.5" />
      {iaCols.map((col, i) => (
        <g>
          <line x1={65 + i * 116.7} y1="58" x2={65 + i * 116.7} y2="70" stroke="var(--d-ink-3)" stroke-width="1.5" />
          <rect x={10 + i * 116.7} y="70" width="110" height="34" rx="8" fill="var(--d-gold-soft)" />
          <text x={65 + i * 116.7} y="92" text-anchor="middle" font-size="13" font-weight="600" fill="var(--d-gold)">{col.title}</text>
          <rect x={10 + i * 116.7} y="110" width="110" height="172" rx="8" fill="var(--d-surface)" />
          {col.items.map((it, k) => <text x={65 + i * 116.7} y={136 + k * 26} text-anchor="middle" font-size="14" fill="var(--d-ink)">{it}</text>)}
        </g>
      ))}
    </svg>
  )}

  {kind === 'loop' && (
    <svg viewBox="0 0 480 192" role="img" aria-label={t('載入迴圈：打開酒店頁、載入逾時、顯示查無酒店、按上一頁後又回到同一頁', 'The loading loop: open a hotel page, the load times out, it says no hotel found, tapping back returns to the same page')}>
      <defs><marker id="arr-l" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--d-ink-3)" /></marker></defs>
      {loopSteps.map((label, i) => (
        <g>
          <rect x={10 + i * 118} y="30" width="108" height="52" rx="10" fill={i === 2 ? 'var(--d-ink)' : 'var(--d-bg)'} stroke={i === 2 ? 'none' : 'var(--d-line)'} />
          <text x={64 + i * 118} y="61" text-anchor="middle" font-size="14" font-weight={i === 2 ? '600' : '400'} fill={i === 2 ? '#fff' : 'var(--d-ink)'}>{label}</text>
          {i < 3 && <line x1={118 + i * 118} y1="56" x2={126 + i * 118} y2="56" stroke="var(--d-ink-3)" stroke-width="1.5" marker-end="url(#arr-l)" />}
        </g>
      ))}
      <path d="M418 82 C418 140, 64 140, 64 88" fill="none" stroke="var(--d-gold)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#arr-l)" />
      <text x="240" y="152" text-anchor="middle" font-size="14" font-weight="600" fill="var(--d-gold)">{t('又回到同一頁，繞成迴圈', 'Back to the same page, in a loop')}</text>
      <text x="240" y="180" text-anchor="middle" font-size="13" fill="var(--d-ink-3)">{t('客人以為酒店不存在，其實只是載入失敗', "Guests think the hotel doesn't exist; the page only failed to load")}</text>
    </svg>
  )}
</div>

<style>
  .diagram { width: 100%; max-width: 560px; margin: 0 auto; --d-bg: #FFFFFF; --d-surface: #F2F5F9; --d-ink: #0E2240; --d-ink-2: #44556E; --d-ink-3: #7D8BA0; --d-line: #DCE3EC; --d-gold: #2F64A8; --d-gold-soft: #E3EDF8; }
  .diagram svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
