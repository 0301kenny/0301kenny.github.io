---
import Base from '../../layouts/Base.astro';
import Todo from '../../components/Todo.astro';
import '../../styles/site.css';
import { langs, asset, type Lang } from '../../i18n';
import { profile, sections as s, legacy, timeline, testimonials, workingWithMe, earlyWorks } from '../../data/profile';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const tx = <V,>(v: V | Record<Lang, V>): V =>
  v && typeof v === 'object' && lang in (v as object) ? (v as Record<Lang, V>)[lang] : (v as V);

const t = {
  eyebrow: 'About',
  title: { 'zh-tw': '把複雜的規則與流程，\n做成好懂、好用的產品', en: 'Turning complex rules and flows\ninto products people understand' },
  intro: {
    'zh-tw': '我是鄭偉助（Kenny），有 8 年以上產品設計經驗。現在在 WOTA 負責官網、LINE LIFF 與銀行白牌（掛銀行品牌的訂房網站）的旅宿訂房產品。工作範圍從分析使用者行為、定義需求、規劃資訊架構，到設計介面、和工程師一起實作與驗收。研究、寫規格、設計和前端開發時，都會用 AI 協助。更早之前，我做了十年品牌與視覺設計。',
    en: 'I am Kenny Cheng, a product designer with 8+ years of experience. At WOTA I work on hotel booking across the website, the LINE mini-app, and white-label sites. My work runs from analyzing user behavior, defining requirements, and planning information architecture to designing interfaces and building and reviewing them with engineers. I use AI throughout research, spec writing, design, and frontend work. Before that, I spent ten years in brand and visual design.',
  },
  photo: { 'zh-tw': '鄭偉助 Kenny Cheng 的照片', en: 'Portrait of Kenny Cheng' },
  facts: [
    { title: { 'zh-tw': '工具', en: 'Tools' }, body: { 'zh-tw': 'Figma · Claude Code · ChatGPT · Codex · Jira · Notion · HTML / CSS · Vue', en: 'Figma · Claude Code · ChatGPT · Codex · Jira · Notion · HTML / CSS · Vue' } },
    { title: { 'zh-tw': '語言', en: 'Languages' }, body: { 'zh-tw': '中文（母語）· 台語（中等）· 英文（讀寫中等）', en: 'Mandarin (native) · Taiwanese (intermediate) · English (intermediate reading and writing)' } },
    { title: { 'zh-tw': '學歷', en: 'Education' }, body: { 'zh-tw': '東海大學 美術系 學士', en: 'BFA, Tunghai University' } },
  ],
  quotes: {
    eyebrow: 'Testimonials',
    title: { 'zh-tw': '合作過的人怎麼說', en: 'What colleagues say' },
    note: { 'zh-tw': '', en: 'Translated from Chinese.' },
  },
  early: { 'zh-tw': '這段時期的作品', en: 'Work from this period' },
  working: { eyebrow: 'Collaboration', title: { 'zh-tw': '和我合作', en: 'Working with me' } },
  legacyTitle: { 'zh-tw': '品牌與視覺設計基礎', en: 'Brand and print foundation' },
};
const title = t.title[lang].split('\n');
---
<Base lang={lang} title={`${t.eyebrow} · Kenny Cheng`} description={t.intro[lang]} path="about">
  <section class="page-head">
    <div class="wrap about-hero">
      <img class="photo" src={asset('img/kenny-portrait.webp')} alt={t.photo[lang]} width="480" height="720">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h1>{title.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
        <p class="lead" style="color:var(--ink-2)">{t.intro[lang]}</p>
      </div>
    </div>
  </section>

  <section style="padding-top:32px">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">{s.experience.eyebrow}</div><h2>{s.experience.title[lang]}</h2></div></div>
      <ol class="timeline">
        {timeline.map((it) => (
          <li class={it.now ? 'now' : undefined}><span class="when">{it.when}</span><div><b>{tx(it.title)}</b><div class="co">{it.org[lang]}</div>
            {'key' in it && it.key === 'fusion' && (
              <p class="early"><span class="early-label">{t.early[lang]}</span>
                {earlyWorks.map((w, i) => (
                  <>{i > 0 && <> <span class="sep" aria-hidden="true">·</span> </>}<a href={w.url} target="_blank" rel="noopener">{w.name}<span class="early-meta"> {w.type[lang]} · {w.year}</span> ↗<span class="thumb" aria-hidden="true"><img src={asset(w.img)} alt="" width="560" height="350" loading="lazy" /></span></a></>
                ))}
              </p>
            )}
          </div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="quotes" aria-labelledby="quotes-title">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">{t.quotes.eyebrow}</div><h2 id="quotes-title">{t.quotes.title[lang]}</h2></div>{t.quotes.note[lang] && <p>{t.quotes.note[lang]}</p>}</div>
      <div class="quote-grid">
        {testimonials.map((q) => (
          <figure class="quote"><blockquote>{q.quote[lang]}</blockquote><figcaption>{q.by[lang]}</figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <section class="working" aria-labelledby="working-title">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">{t.working.eyebrow}</div><h2 id="working-title">{t.working.title[lang]}</h2></div></div>
      <ol class="working-list">
        {workingWithMe.map((w) => <li><h3>{w.title[lang]}</h3><p>{w.body[lang]}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="legacy">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">{s.legacy.eyebrow}</div><h2>{t.legacyTitle[lang]}</h2></div><p>{s.legacy.lead[lang]}</p></div>
      <div class="legacy-grid">
        {legacy.map((l) => (
          <div class="legacy-card"><h3>{l.title[lang]}</h3><span class="when">{l.when[lang]}</span><ul>{l.items[lang].map((x) => <li>{x}</li>)}{'works' in l && l.works.map((w) => <li><a href={w.url} target="_blank" rel="noopener" class="work-link">{w.title[lang]} ↗</a></li>)}</ul></div>
        ))}
      </div>
      <p style="margin-top:28px"><a class="btn btn-ghost" href={profile.contact.behance} target="_blank" rel="noopener">{s.legacy.behance[lang]}</a></p>
    </div>
  </section>

  <section>
    <div class="wrap facts">
      {t.facts.map((f) => <div><b>{f.title[lang]}</b><p>{f.body[lang]}</p></div>)}
    </div>
  </section>
</Base>
