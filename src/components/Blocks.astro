---
import Todo from './Todo.astro';
import Diagram from './Diagram.astro';
import { ui, asset, type Lang } from '../i18n';
import { imageSizes } from '../data/imageSizes';
import type { Block } from '../data/cases';
import { phrases } from '../utils/phrases';
import { valText } from '../variant';

interface Props { blocks: Block[]; lang: Lang }
const { blocks, lang } = Astro.props;
---
{blocks.map((bk) => {
  switch (bk.t) {
    case 'p':
      return <p>{bk.text[lang]}{bk.todo && <Todo lang={lang} />}</p>;
    case 'h3':
      return <h3>{phrases(bk.text[lang]).map((ph) => <span class="ph">{ph}</span>)}</h3>;
    case 'callout':
      return <div class="callout"><b>{bk.title[lang]}</b><p>{bk.text[lang]}</p></div>;
    case 'decision':
      return (
        <div class="decision">
          <div class="q">{bk.q[lang]}</div>
          <div class="a">{bk.a[lang]}{bk.todo && <Todo lang={lang} />}</div>
          <p>{bk.text[lang]}</p>
        </div>
      );
    case 'figure':
      return (
        <figure class="fig">
          <div class={bk.phone ? 'frame phone-fig' : bk.pair ? 'frame pair' : 'frame'}>
            {bk.src.map((src) => <img src={asset(src)} alt={bk.alt[lang]} loading="lazy" width={imageSizes[src]?.[0]} height={imageSizes[src]?.[1]} />)}
          </div>
          <figcaption>{bk.caption[lang]}</figcaption>
        </figure>
      );
    case 'table':
      return (
        <>
          <table class={bk.head ? 'wrap-first' : undefined}>
            <thead><tr>{(bk.head ?? [ui.case.stage, ui.case.aiDoes, ui.case.iDo]).map((h) => <th>{h[lang]}</th>)}</tr></thead>
            <tbody>{bk.rows.map(([a, b, c]) => <tr><td>{a[lang]}</td><td>{b[lang]}</td><td>{c[lang]}</td></tr>)}</tbody>
          </table>
          {bk.note && <p class="note">{bk.note[lang]}</p>}
        </>
      );
    case 'stats':
      return <div class="issues">{bk.items.map(([v, l]) => <div><b>{valText(v, lang)}</b><span>{l[lang]}</span></div>)}</div>;
    case 'guard':
      return <div class="guard">{bk.items.map(([title, code, desc]) => <div><b>{title[lang]}</b>{code && <code>{code}</code>}<br />{desc[lang]}</div>)}</div>;
    case 'diagram':
      return <figure class="fig"><div class="frame"><Diagram kind={bk.kind} lang={lang} /></div><figcaption>{bk.caption[lang]}</figcaption></figure>;
    case 'list':
      return bk.ordered
        ? <ol class="list">{bk.items.map((it) => <li>{it[lang]}</li>)}</ol>
        : <ul class="list">{bk.items.map((it) => <li>{it[lang]}</li>)}</ul>;
    case 'flow':
      return <div class="flow">{bk.items.map((it, i) => <>{i > 0 && <i aria-hidden="true">→</i>}<span>{it[lang]}</span></>)}</div>;
    case 'versions':
      return <ol class="versions">{bk.items.map(([v, text]) => <li><b>{typeof v === 'string' ? v : v[lang]}</b>{text[lang]}</li>)}</ol>;
    case 'more':
      return (
        <details class="more-detail">
          <summary>{bk.label[lang]}</summary>
          <div class="more-body"><Astro.self blocks={bk.blocks} lang={lang} /></div>
        </details>
      );
    case 'compare':
      return (
        <div class="compare">
          <div class="head"><b>{(bk.title ?? ui.case.evidence)[lang]}</b></div>
          <div class="cols">
            <div class="col"><small>{(bk.aiLabel ?? ui.case.aiDraft)[lang]}</small>{bk.ai[lang]}</div>
            <div class="col me"><small>{(bk.meLabel ?? ui.case.myRevision)[lang]}</small>{bk.me[lang]}</div>
          </div>
          <p>{bk.source[lang]}</p>
        </div>
      );
  }
})}
