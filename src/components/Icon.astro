---
// 簡約線條 icon，顏色跟著文字色（currentColor）。
export type IconName = 'search' | 'doc' | 'pen' | 'code' | 'check' | 'download' | 'mail' | 'external';
interface Props { name: IconName; size?: number; class?: string; filled?: boolean }
const { name, size = 20, class: cls, filled = false } = Astro.props;
const paths: Record<IconName, string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  doc: '<path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  pen: '<path d="M12 20h8"/><path d="M16.4 3.6a2 2 0 0 1 2.9 2.9L7 18.8 3 20l1.2-4z"/>',
  code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>',
};
// 扁平填色版：主體用 currentColor 填滿，細節用 --icon-cut（預設白色）畫出鏤空效果。
const cut = 'stroke="var(--icon-cut, #fff)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"';
const filledPaths: Partial<Record<IconName, string>> = {
  search: `<circle cx="10.5" cy="10.5" r="7.5" fill="currentColor"/><path d="M15.8 14.4l5 5a1.5 1.5 0 0 1-2.1 2.1l-5-5z" fill="currentColor"/><path d="M7.2 9.6a3.6 3.6 0 0 1 2.6-2.6" ${cut}/>`,
  doc: `<path d="M6.5 2h7.8L20 7.7v12.8a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 5 20.5v-17A1.5 1.5 0 0 1 6.5 2z" fill="currentColor"/><path d="M14 2.5V8h5.5M9 13h6M9 17h4" ${cut}/>`,
  pen: `<path d="M15 4.4a2.6 2.6 0 0 1 3.7 0l.9.9a2.6 2.6 0 0 1 0 3.7L9.2 19.4 3 21l1.6-6.2z" fill="currentColor"/><path d="M13.5 6l4.5 4.5" ${cut}/>`,
  code: `<rect x="2" y="4" width="20" height="16" rx="3" fill="currentColor"/><path d="M9.5 9l-3 3 3 3M14.5 9l3 3-3 3" ${cut}/>`,
  check: `<circle cx="12" cy="12" r="10" fill="currentColor"/><path d="m8 12.2 2.8 2.8 5.2-5.6" ${cut}/>`,
};
const fp = filled ? filledPaths[name] : undefined;
---
{fp
  ? <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={fp} />
  : <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />}
