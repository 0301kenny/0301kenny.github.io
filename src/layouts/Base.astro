---
import { htmlLang, otherLang, ui, url, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const alt = otherLang(lang);
const home = url(lang);
const links: [string, string][] = [
  [`${home}#work`, ui.nav.work[lang]],
  [`${home}#approach`, ui.nav.approach[lang]],
  [`${home}#legacy`, ui.nav.legacy[lang]],
  [url(lang, 'about'), ui.nav.about[lang]],
];
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="alternate" hreflang={htmlLang[alt]} href={url(alt, path)}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{ui.nav.skip[lang]}</a>
  {ui.draftEn[lang] && <div class="lang-note">{ui.draftEn[lang]}</div>}
  <header class="nav">
    <div class="wrap">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={ui.nav.mainMenu[lang]}>
        <span></span><span></span><span></span>
      </button>
      <a class="brand" href={home}>{profile.nameEn}{lang === 'zh-tw' && <small>{profile.name['zh-tw']}</small>}</a>
      <nav aria-label={ui.nav.mainMenu[lang]}>
        <ul>
          {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <div class="nav-right">
        <div class="lang" role="group" aria-label={ui.nav.language[lang]}>
          <a href={url('zh-tw', path)} aria-current={lang === 'zh-tw' ? 'true' : undefined} lang="zh-Hant">中</a>
          <a href={url('en', path)} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
        </div>
        <a class="btn btn-primary btn-sm" href={url(lang, 'resume')}>{ui.nav.resume[lang]}</a>
      </div>
    </div>
    <div id="mobile-menu" class="mobile-menu" hidden>
      <nav aria-label={ui.nav.mainMenu[lang]}>
        <ul>
          {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <div class="lang" role="group" aria-label={ui.nav.language[lang]}>
        <a href={url('zh-tw', path)} aria-current={lang === 'zh-tw' ? 'true' : undefined} lang="zh-Hant">中文</a>
        <a href={url('en', path)} aria-current={lang === 'en' ? 'true' : undefined} lang="en">English</a>
      </div>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer>
    <div class="wrap">
      <span>© 2026 Kenny Cheng 鄭偉助</span>
      <span>{ui.footerBuilt[lang]} · <a href={profile.contact.github} target="_blank" rel="noopener">{ui.source[lang]}</a></span>
    </div>
  </footer>
  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; };
      btn.addEventListener('click', () => set(menu.hidden));
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
      matchMedia('(min-width: 961px)').addEventListener('change', (e) => { if (e.matches) set(false); });
    }
  </script>
  <style is:global>
    .menu-btn { display: none; width: 40px; height: 36px; padding: 0; border: 1px solid #EEF1F5; border-radius: 8px; background: transparent; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
    .menu-btn span { display: block; width: 18px; height: 1.5px; background: var(--ink); transition: transform .2s ease, opacity .2s ease; }
    .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
    .mobile-menu { border-top: 1px solid var(--line); background: #fff; padding: 4px 24px 20px; }
    .nav .mobile-menu ul { display: block; list-style: none; margin: 0; padding: 0; }
    .mobile-menu li a { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); font-size: 16px; }
    .mobile-menu .lang { display: inline-flex; margin-top: 16px; font-size: 13px; }
    .mobile-menu .lang a { padding: 6px 14px; }
    @media (max-width: 960px) { .menu-btn { display: inline-flex; margin-right: -4px; } .nav .brand { margin-right: auto; } }
    @media (max-width: 600px) { .mobile-menu { padding: 4px 16px 20px; } .nav-right { gap: 10px; } }
    @media (min-width: 961px) { .mobile-menu { display: none !important; } }
  </style>
</body>
</html>
